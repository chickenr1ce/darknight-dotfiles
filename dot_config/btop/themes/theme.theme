# Rendered by scripts/render-theme.sh from the active theme palette.
# Do not edit: the next palette load overwrites this file.
#
# btop lists user themes from ~/.config/btop/themes/. Pick `theme` once in
# btop's options menu (Esc -> Color theme); see docs/user/theme-desktop-setup.md.

# Main background. Empty would mean the terminal background; a theme supplies
# one, so btop paints its own.
theme[main_bg]="#141118"

# Main text color
theme[main_fg]="#cac4d4"

# Title color for boxes
theme[title]="#b4befe"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b4befe"

# Background color of the selected process
theme[selected_bg]="#3a3450"

# Text color of the selected process
theme[selected_fg]="#cac4d4"

# Color of inactive/disabled text
theme[inactive_fg]="#9d93ad"

# Text painted on top of graphs (uptime, graph scaling)
theme[graph_text]="#9d93ad"

# Background of the percentage meters
theme[meter_bg]="#282936"

# Misc colors for the processes box, including mini CPU graphs
theme[proc_misc]="#b4befe"

# Box outline colors
theme[cpu_box]="#a980db"
theme[mem_box]="#a6e3a1"
theme[net_box]="#ff5252"
theme[proc_box]="#b4befe"

# Box divider and small-box line color
theme[div_line]="#9d93ad"

# Temperature gradient
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#d7d370"
theme[temp_end]="#ff5252"

# CPU gradient
theme[cpu_start]="#94e2d5"
theme[cpu_mid]="#89b4fa"
theme[cpu_end]="#a980db"

# Mem/Disk free meter
theme[free_start]="#a980db"
theme[free_mid]="#89b4fa"
theme[free_end]="#94e2d5"

# Mem/Disk cached meter
theme[cached_start]="#89b4fa"
theme[cached_mid]="#94e2d5"
theme[cached_end]="#a980db"

# Mem/Disk available meter
theme[available_start]="#d7d370"
theme[available_mid]="#ff5252"
theme[available_end]="#ff5252"

# Mem/Disk used meter
theme[used_start]="#a6e3a1"
theme[used_mid]="#94e2d5"
theme[used_end]="#89b4fa"

# Download graph
theme[download_start]="#d7d370"
theme[download_mid]="#ff5252"
theme[download_end]="#ff5252"

# Upload graph
theme[upload_start]="#a6e3a1"
theme[upload_mid]="#94e2d5"
theme[upload_end]="#89b4fa"

# Process gradient for threads, memory, and CPU usage
theme[process_start]="#94e2d5"
theme[process_mid]="#89b4fa"
theme[process_end]="#a980db"

# Process box states. Pause/follow paint a colored ground, so their text uses
# the black-or-white ink chosen against that ground.
theme[proc_pause_bg]="#ff5252"
theme[proc_follow_bg]="#89b4fa"
theme[proc_banner_bg]="#b4befe"
theme[proc_banner_fg]="#000000"

# Followed process
theme[followed_bg]="#89b4fa"
theme[followed_fg]="#000000"
