#!/usr/bin/env bash
# xbox-pad-fix — recover the Xbox Wireless Controller's Bluetooth pairing.
#
# Fixes this symptom:
#   [SIGNAL] Disconnected - org.bluez.Reason.Authentication,
#            Connection terminated due to authentication failure
# i.e. the link key stored on this PC no longer matches the one held by the
# controller, so every connection attempt is rejected. Retrying can never
# work; the stale key has to go and the device re-paired.
#
# Run as your normal user (no sudo needed). You will be asked to put the
# controller into pairing mode partway through.

set -uo pipefail

MAC="F4:6A:D7:A9:1A:AE"
NAME="Xbox Wireless Controller"

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

command -v bluetoothctl >/dev/null 2>&1 || { echo "bluetoothctl not found" >&2; exit 1; }

step "Current state"
if bluetoothctl info "$MAC" 2>/dev/null | grep -q 'Device '; then
    bluetoothctl info "$MAC" 2>/dev/null | grep -E '^[[:space:]]*(Name|Paired|Bonded|Trusted|Connected)'
else
    echo "  $NAME is not known to BlueZ"
fi

step "Clearing the stale link key"
if bluetoothctl remove "$MAC" 2>&1 | grep -q 'removed'; then
    echo "  removed $MAC"
else
    echo "  nothing to remove"
fi

step "Restarting the Bluetooth service"
systemctl restart bluetooth && echo "  done"

step "Put the controller in pairing mode"
cat <<'EOF'
  Hold the pairing button (top edge, next to the USB-C port) for about
  3 seconds, until the Xbox logo blinks rapidly instead of staying solid.
EOF
printf '  Press Enter once it is blinking... '
read -r _

step "Pairing"
{
    echo "scan on";  sleep 8
    echo "pair $MAC"; sleep 6
    echo "trust $MAC"
    echo "connect $MAC"; sleep 12
    echo "info $MAC"
    echo "quit"
} | bluetoothctl 2>&1 \
  | sed 's/\x1b\[[0-9;]*m//g' \
  | grep -E 'Pairing successful|Failed|Reason|Paired:|Bonded:|Trusted:|Connected:|Battery Percentage'

step "Result"
sleep 3
if [[ -e /dev/input/js0 ]] && bluetoothctl info "$MAC" 2>/dev/null | grep -q 'Connected: yes'; then
    echo "  OK — connected, /dev/input/js0 present"
else
    echo "  Still not connected."
    echo "  Re-run this script. If it keeps failing, the controller is probably"
    echo "  bonded to another host (console, phone, another PC) — unpair it"
    echo "  there first, then run this again."
fi
