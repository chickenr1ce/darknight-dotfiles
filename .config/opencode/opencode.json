{
	"$schema": "https://opencode.ai/config.json",
	"model": "deepseek/deepseek-v4-flash",
	"providers": {
		"local-rig": {
			"package": "aisdk:@ai-sdk/openai-compatible",
			"name": "Local GPU Rig",
			"settings": {
				"baseURL": "http://127.0.0.1:8033/v1",
				"apiKey": "ignored"
			},
			"models": {
				"gemma-4": {
					"name": "Gemma 4",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				},
				"qwen-3-6": {
					"name": "Qwen 3-6 (IQ4_XS)",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				}
			}
		}
	},
	"permissions": [
		{
			"action": "websearch",
			"resource": "*",
			"effect": "allow"
		},
		{
			"action": "shell",
			"resource": "git commit *",
			"effect": "ask"
		},
		{
			"action": "shell",
			"resource": "git push *",
			"effect": "ask"
		}
	],
	"mcp": {
		"servers": {
			"cg": {
				"type": "local",
				"command": [
					"codegraph",
					"serve",
					"--mcp"
				],
				"disabled": false
			}
		}
	},
	"plugins": [
		"./plugins/caveman/plugin.js",
		"./plugins/codegraph/plugin.js"
	],
	"compaction": {
		"keep": {
			"tokens": 8000
		},
		"buffer": 20000
	}
}
