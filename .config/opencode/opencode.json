{
	"$schema": "https://opencode.ai/config.json",
	"model": "opencode-go/deepseek-v4-flash",
	"provider": {
		"local-rig": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local GPU Rig",
			"options": {
				"baseURL": "http://127.0.0.1:8033/v1",
				"apiKey": "ignored"
			},
			"models": {
				"local-model": {
					"name": "Local Model",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				}
			}
		}
	},
	"permission": {
		"websearch": "allow",
		"bash": {
			"git commit *": "ask",
			"git push *": "ask"
		},
		"task": {
			"vision": "allow"
		}
	},
	"mcp": {
		"cg": {
			"type": "local",
			"command": [
				"codegraph",
				"serve",
				"--mcp"
			],
			"enabled": true
		}
	},
	"plugin": [
		"./plugins/caveman/plugin.js",
		"./plugins/codegraph/plugin.js"
	],
	"compaction": {
		"preserve_recent_tokens": 8000,
		"reserved": 20000
	}
}
