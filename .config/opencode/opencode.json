{
	"$schema": "https://opencode.ai/config.json",
	"mcp": {
		"qt-docs": {
			"type": "remote",
			"url": "https://qt-docs-mcp.qt.io/mcp",
			"enabled": true
		}
	},
	"provider": {
		"local-rig": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local GPU Rig",
			"options": {
				"baseURL": "http://127.0.0.1:8033/v1",
				"apiKey": "ignored"
			},
			"models": {
				"local-model": {
					"name": "Local Model",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				}
			}
		}
	},
	"permission": {
		"websearch": "allow",
		"bash": {
			"git commit *": "ask",
			"git push *": "ask"
		}
	},
	"compaction": {
		"preserve_recent_tokens": 8000,
		"reserved": 20000
	}
}
