{
	"$schema": "https://opencode.ai/config.json",
	"model": "deepseek/deepseek-v4-flash",
	"provider": {
		"local-rig": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Local GPU Rig",
			"options": {
				"baseURL": "http://127.0.0.1:8033/v1",
				"apiKey": "ignored"
			},
			"models": {
				"gemma-4": {
					"name": "Gemma 4",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				},
				"qwen-3-6": {
					"name": "Qwen 3-6 (IQ4_XS)",
					"limit": {
						"context": 100000,
						"output": 32768
					}
				}
			}
		}
	},
	"permission": {
		"websearch": "allow"
	},
	"agent": {
		"build": {
			"mode": "primary",
			"description": "Primary coding agent that delegates command execution to @executor",
			"permission": {
				"bash": "deny",
				"websearch": "allow"
			},
			"prompt": "{file:./prompts/coding-guideline.md}"
		},
		"plan": {
			"mode": "primary",
			"description": "Structured implementation planning that delegates command execution to @executor",
			"permission": {
				"bash": "deny",
				"websearch": "allow"
			},
			"prompt": "{file:./prompts/plan-guideline.md}"
		},
		"explore": {
			"description": "Fast codebase exploration",
			"model": "deepseek/deepseek-v4-flash",
			"variant": "max",
			"prompt": "{file:./prompts/explore-guideline.md}"
		},
		"executor": {
			"mode": "subagent",
			"description": "Default execution subagent for bash commands, tests, builds, and validation",
			"model": "deepseek/deepseek-v4-flash",
			"prompt": "{file:./prompts/executor-guideline.md}"
		}
	},
	"mcp": {
		"cg": {
			"type": "local",
			"command": ["codegraph", "serve", "--mcp"],
			"enabled": true
		}
	},
	"plugin": [
		"./plugins/caveman/plugin.js",
		"./plugins/codegraph/plugin.js"
	]
}
